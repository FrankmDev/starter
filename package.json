{
  "name": "frnq-astro-starter",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "bun run format:check && bun run check && bun run test && astro build",
    "preview": "astro preview",
    "sync": "astro sync",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "bun run scripts/validate-project.ts",
    "audit": "bun audit",
    "check": "bun run validate && astro check",
    "test": "bun test",
    "qa": "bun run build",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-uri": "3.1.4"
  }
}
