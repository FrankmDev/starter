---
import JsonLd from "@/components/JsonLd.astro";
import SEO from "@/components/SEO.astro";
import { projectConfig } from "../../project.config";
import "@/styles/globals.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  schema,
  noindex = !projectConfig.initialized,
  ...seoProps
} = Astro.props;
---

<!doctype html>
<html lang={projectConfig.site.language} dir={projectConfig.site.direction}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={projectConfig.site.colorScheme} />
    <SEO {...seoProps} noindex={noindex} />
    {schema && <JsonLd data={schema} />}
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      class="fixed start-3 top-3 z-50 -translate-y-[calc(100%+2rem)] rounded-radius bg-ink px-4 py-3 font-semibold text-canvas no-underline focus:translate-y-0"
      href="#main-content"
    >
      {projectConfig.ui.skipToContent}
    </a>
    <slot name="header" />
    <main id="main-content" class="min-w-0 flex-1" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
