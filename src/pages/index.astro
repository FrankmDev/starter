---
import Container from "@/components/Container.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projectConfig } from "../../project.config";

const title =
  projectConfig.seo.defaultTitle || projectConfig.site.name || "Astro starter";
const description =
  projectConfig.seo.defaultDescription ||
  "Completa START_HERE.md para inicializar este proyecto.";
const schema = projectConfig.initialized
  ? {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: projectConfig.site.name,
      url: projectConfig.site.url,
      publisher: {
        "@type": "Organization",
        name: projectConfig.site.company,
        url: projectConfig.site.url,
      },
    }
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  {...schema ? { schema } : {}}
>
  <section
    class="grid min-h-svh items-center py-section"
    aria-labelledby="foundation-title"
  >
    <Container size="reading">
      <div class="space-y-6">
        <p class="text-sm font-bold tracking-wide text-muted uppercase">
          {projectConfig.initialized ? "Base preparada" : "Astro starter"}
        </p>
        <h1 id="foundation-title">{title}</h1>
        <p>{description}</p>
      </div>
    </Container>
  </section>
</BaseLayout>
