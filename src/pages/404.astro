---
import Container from "@/components/Container.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projectConfig } from "../../project.config";
---

<BaseLayout
  title={projectConfig.ui.notFoundTitle}
  description={projectConfig.ui.notFoundDescription}
  noindex
>
  <section
    class="grid min-h-svh items-center py-section"
    aria-labelledby="not-found-title"
  >
    <Container size="reading">
      <div class="space-y-6">
        <p class="text-heading text-muted" aria-hidden="true">404</p>
        <h1 id="not-found-title">{projectConfig.ui.notFoundTitle}</h1>
        <p>{projectConfig.ui.notFoundDescription}</p>
        <a
          class="inline-flex min-h-11 items-center rounded-radius bg-accent px-5 py-3 font-semibold text-canvas"
          href="/"
        >
          {projectConfig.ui.returnHome}
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
