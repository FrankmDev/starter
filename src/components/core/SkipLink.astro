---
import { uiText } from "@/config/ui";

interface Props {
  target?: string;
  label?: string;
}

const { target = "main-content", label = uiText.skipToContent } = Astro.props;
---

<a
  class="fixed start-3 top-3 z-50 -translate-y-[calc(100%+2rem)] rounded-sm bg-surface-inverse px-4 py-3 font-bold text-ink-inverse no-underline transition-transform duration-[var(--motion-fast)] ease-out focus:translate-y-0"
  href={`#${target}`}
>
  {label}
</a>
