---
import { Image } from 'astro:assets';

interface CommonProps {
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  fit?: 'cover' | 'contain' | 'fill' | 'none' | 'scale-down';
  position?: string;
  class?: string;
}

type Props = CommonProps &
  (
    | {
        src: ImageMetadata;
        width?: number;
        height?: number;
      }
    | {
        src: string;
        width: number;
        height: number;
      }
  );

const {
  src,
  alt,
  width,
  height,
  widths = [480, 768, 1024, 1440, 1920],
  sizes = '100vw',
  fetchpriority = 'auto',
  fit = 'cover',
  position = 'center',
  class: className,
} = Astro.props;

const loading = Astro.props.loading ?? (fetchpriority === 'high' ? 'eager' : 'lazy');
const isExternalOrPublicSource = typeof src === 'string';
const localDimensions = width !== undefined && height !== undefined ? { width, height } : {};
const optionalClass = className ? { class: className } : {};
---

{isExternalOrPublicSource ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
    decoding="async"
    style={`object-fit: ${fit}; object-position: ${position};`}
  />
) : (
  <Image
    src={src}
    alt={alt}
    {...localDimensions}
    widths={widths}
    sizes={sizes}
    loading={loading}
    fetchpriority={fetchpriority}
    fit={fit}
    position={position}
    {...optionalClass}
    decoding="async"
  />
)}
