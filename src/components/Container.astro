---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  size?: "content" | "reading";
}

const { size = "content", class: className, ...rest } = Astro.props;
const sizeClass = size === "reading" ? "max-w-reading" : "max-w-content";
---

<div
  class:list={["mx-auto w-full min-w-0 px-gutter", sizeClass, className]}
  {...rest}
>
  <slot />
</div>
