---
interface Props {
  id: string;
  label: string;
  help?: string | undefined;
  error?: string | undefined;
  required?: boolean;
  helpId?: string | undefined;
  errorId?: string | undefined;
  class?: string | undefined;
}

const {
  id,
  label,
  help,
  error,
  required = false,
  helpId,
  errorId,
  class: className,
} = Astro.props;
---

<div
  class:list={["grid min-w-0 gap-2", className]}
  data-invalid={Boolean(error) || undefined}
>
  <label class="font-bold" for={id}>
    {label}
    {
      required && (
        <span class="ms-1 text-danger" aria-hidden="true">
          *
        </span>
      )
    }
  </label>
  <slot />
  {
    help && (
      <p id={helpId} class="text-sm text-muted">
        {help}
      </p>
    )
  }
  {
    error && (
      <p id={errorId} class="text-sm text-danger" role="alert">
        {error}
      </p>
    )
  }
</div>
