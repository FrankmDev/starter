---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  spacing?: 'none' | 'compact' | 'default';
}

const { spacing = 'default', class: className, ...rest } = Astro.props;
const spacingClasses = {
  none: '',
  compact: 'py-section-compact',
  default: 'py-section',
};
---

<section class:list={[spacingClasses[spacing], className]} {...rest}>
  <slot />
</section>
