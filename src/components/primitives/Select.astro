---
import type { HTMLAttributes } from "astro/types";
import { fieldAccessibility } from "@/lib/forms/field";
import FieldShell from "./internal/FieldShell.astro";

type NativeProps = Omit<
  HTMLAttributes<"select">,
  | "id"
  | "class"
  | "required"
  | "aria-describedby"
  | "aria-errormessage"
  | "aria-invalid"
>;

interface Props extends NativeProps {
  id: string;
  label: string;
  help?: string | undefined;
  error?: string | undefined;
  required?: boolean;
  class?: string | undefined;
  fieldClass?: string | undefined;
  "aria-describedby"?: string | undefined;
}

const {
  id,
  label,
  help,
  error,
  required = false,
  class: className,
  fieldClass,
  ...rest
} = Astro.props;

const accessibility = fieldAccessibility({
  id,
  help,
  error,
  describedBy: Astro.props["aria-describedby"],
});
---

<FieldShell
  {id}
  {label}
  {help}
  {error}
  {required}
  helpId={accessibility.helpId}
  errorId={accessibility.errorId}
  class={fieldClass}
>
  <select
    {...rest}
    {id}
    {required}
    class:list={[
      "min-h-11 w-full rounded-sm border border-border bg-surface px-3 py-2 text-ink disabled:cursor-not-allowed disabled:opacity-55",
      className,
    ]}
    aria-describedby={accessibility.describedBy}
    aria-errormessage={accessibility.errorMessage}
    aria-invalid={accessibility.invalid}
  >
    <slot />
  </select>
</FieldShell>
